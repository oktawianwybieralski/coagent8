  },
  "websiteUrl": "https://github.com/oktawianwybieralski/coagent8",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/oktawianwybieralski/coagent8/develop/assets/logo256.png",
      "mimeType": "image/png",
      "sizes": ["256x256"],
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/oktawianwybieralski/coagent8/develop/assets/logo256-light.png",
