      "sizes": ["256x256"],
      "theme": "dark"
    }
  ],
  "version": "0.7.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "coagent8",
