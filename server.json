{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.oktawianwybieralski/coagent8",
  "title": "CoAgent8",
  "description": "Second opinions and Git reviews from local Codex, Claude Code and Antigravity CLIs.",
  "repository": {
