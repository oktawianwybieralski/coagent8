{
  "name": "coagent8-mcp",
  "displayName": "CoAgent8 - MCP bridge to coding CLIs",
  "description": "Ask Codex, Claude Code and Antigravity for second opinions and Git reviews from VS Code chat through MCP.",
  "version": "1.0.0-beta.2",
  "publisher": "okidev",
  "author": { "name": "Oktawian Wybieralski", "url": "https://oki.dev" },
  "homepage": "https://oki.dev",
  "bugs": { "url": "https://github.com/oktawianwybieralski/coagent8/issues" },
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/oktawianwybieralski/coagent8.git" },
  "engines": { "vscode": "^1.101.0" },
  "categories": ["AI", "Chat"],
  "keywords": ["mcp", "codex", "claude", "claude-code", "antigravity", "gemini", "code-review", "coding-agents"],
  "galleryBanner": { "color": "#1f262e", "theme": "dark" },
  "preview": true,
  "markdown": "github",
  "qna": "https://github.com/oktawianwybieralski/coagent8/issues",
  "extensionKind": ["workspace"],
  "main": "./dist/extension.cjs",
  "icon": "assets/logo.png",
  "files": ["dist/**", "assets/**", "README.md", "CHANGELOG.md", "LICENSE"],
  "activationEvents": ["onMcpServerDefinitionProvider:coagent8", "onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "CoAgent8 runs local coding CLIs and requires a trusted workspace." },
    "virtualWorkspaces": { "supported": false, "description": "CoAgent8 needs a filesystem workspace and locally available Node.js and coding CLIs." }
  },
  "contributes": {
    "commands": [
      { "command": "coagent8.setup", "title": "CoAgent8: Set Up Coding CLIs" },
      { "command": "coagent8.refreshCliStatus", "title": "CoAgent8: Refresh CLI Status" },
      { "command": "coagent8.registerNativeHosts", "title": "CoAgent8: Register or Repair Native Chat Hosts" },
      { "command": "coagent8.cleanup", "title": "CoAgent8: Preview and Remove Owned Registrations" }
    ],
    "mcpServerDefinitionProviders": [{ "id": "coagent8", "label": "CoAgent8" }],
    "configuration": {
      "title": "CoAgent8",
      "properties": {
        "coagent8.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node.js 24+ executable used to run the bundled MCP server. Set an absolute executable path if Node.js is not on PATH."
        }
      }
    }
  }
}
