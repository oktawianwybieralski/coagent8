{
  "$schema": "https://typedoc.org/schema.json",
  "name": "CoAgent8",
  "entryPoints": [
    "../../src"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "../../tsconfig.json",
  "out": "../../.artifacts/api-docs",
  "readme": "../../README.md",
  "treatWarningsAsErrors": true,
  "projectDocuments": [
    "../../docs/ARCHITECTURE.md",
    "../../docs/ROADMAP.md",
    "../../docs/HANDOFF.md",
    "../../CHANGELOG.md",
