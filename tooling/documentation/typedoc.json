  ],
  "highlightLanguages": [
    "bash",
    "bat",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "mermaid"
  ],
  "customJs": "mermaid.js"
}
