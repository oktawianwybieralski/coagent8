{
  "name": "coagent8",
  "displayName": "CoAgent8 - MCP bridge to coding CLIs",
  "version": "1.0.0-beta.2",
  "description": "Expose local coding CLIs through MCP with public conversation history and read-only execution profiles.",
  "main": "dist/index.cjs",
  "bin": {
    "coagent8": "./dist/index.cjs",
    "coagent8-mcp": "./dist/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oktawianwybieralski/coagent8.git"
  },
  "author": {
    "name": "Oktawian Wybieralski",
    "url": "https://oki.dev"
  },
  "homepage": "https://oki.dev",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "files": [
    "dist/",
    "index.js",
    "src/",
    "skills/",
    "assets/logo.svg",
    "assets/logo.png",
    "assets/logo32.png",
    "assets/logo64.png",
    "assets/logo256.png",
    "assets/logo-light.svg",
    "assets/logo-light.png",
    "assets/logo32-light.png",
    "assets/logo64-light.png",
    "assets/logo256-light.png",
    "plugin.json",
    "mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0",
      "onFail": "error"
    }
  },
  "bugs": {
    "url": "https://github.com/oktawianwybieralski/coagent8/issues"
  },
  "scripts": {
    "lint:docs": "node tooling/documentation/node_modules/eslint/bin/eslint.js --config tooling/documentation/eslint.config.cjs src --max-warnings 0",
    "docs": "npm --prefix tooling/documentation run build",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extensions/vscode/tsconfig.json",
    "check:dependencies": "node scripts/check-dependencies.cjs",
    "package:artifacts": "node scripts/package-artifacts.cjs",
    "package:vscode": "npm run package:artifacts && npm --prefix tooling/vscode run package",
    "start": "node dist/index.cjs",
    "test": "node tests/run.cjs",
    "prepack": "npm run build",
    "test:coverage": "c8 --all --include=src/**/*.ts --check-coverage --statements=70 --lines=70 --branches=70 --functions=75 --reporter=text --reporter=json-summary --reports-dir=.artifacts/coverage node tests/run.cjs",
    "test:consumer": "node tests/consumer/smoke.cjs",
    "changelog": "git-cliff --config cliff.toml --output CHANGELOG.md v1.0.0-beta.2..HEAD",
    "changelog:check": "git-cliff --config cliff.toml --unreleased --strip all v1.0.0-beta.2..HEAD",
    "release-notes": "git-cliff --config cliff.release-notes.toml --unreleased v1.0.0-beta.2..HEAD"
  },
  "keywords": [
    "cli",
    "codex",
    "claude",
    "claude-code",
    "gemini",
    "gemini-cli",
    "mcp",
    "agent",
    "bridge",
    "code-review",
    "multi-agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "1.101.0",
    "c8": "10.1.3",
    "esbuild": "0.25.12",
    "git-cliff": "2.14.2",
    "tsdown": "0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
